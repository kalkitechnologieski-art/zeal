@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 0 0% 100%;
    --foreground: 222.2 84% 4.9%;
    --card: 0 0% 100%;
    --card-foreground: 222.2 84% 4.9%;
    --popover: 0 0% 100%;
    --popover-foreground: 222.2 84% 4.9%;
    --primary: 222.2 47.4% 11.2%;
    --primary-foreground: 210 40% 98%;
    --secondary: 210 40% 96.1%;
    --secondary-foreground: 222.2 47.4% 11.2%;
    --muted: 210 40% 96.1%;
    --muted-foreground: 215.4 16.3% 46.9%;
    --accent: 210 40% 96.1%;
    --accent-foreground: 222.2 47.4% 11.2%;
    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 210 40% 98%;
    --border: 214.3 31.8% 91.4%;
    --input: 214.3 31.8% 91.4%;
    --ring: 222.2 84% 4.9%;
    --radius: 1rem;
    --touch-target: 44px;
    --font-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    --font-sm: clamp(0.875rem, 0.8rem + 0.375vw, 1rem);
    --font-base: clamp(1rem, 0.9rem + 0.5vw, 1.125rem);
    --font-lg: clamp(1.125rem, 1rem + 0.625vw, 1.25rem);
    --font-xl: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem);
    --font-2xl: clamp(1.5rem, 1.3rem + 1vw, 2rem);
    --font-3xl: clamp(2rem, 1.7rem + 1.5vw, 2.5rem);
    --font-4xl: clamp(2.5rem, 2rem + 2.5vw, 3.5rem);
  }

  .dark {
    --background: 222.2 84% 4.9%;
    --foreground: 210 40% 98%;
    --card: 222.2 84% 4.9%;
    --card-foreground: 210 40% 98%;
    --popover: 222.2 84% 4.9%;
    --popover-foreground: 210 40% 98%;
    --primary: 210 40% 98%;
    --primary-foreground: 222.2 47.4% 11.2%;
    --secondary: 217.2 32.6% 17.5%;
    --secondary-foreground: 210 40% 98%;
    --muted: 217.2 32.6% 17.5%;
    --muted-foreground: 215 20.2% 65.1%;
    --accent: 217.2 32.6% 17.5%;
    --accent-foreground: 210 40% 98%;
    --destructive: 0 62.8% 30.6%;
    --destructive-foreground: 210 40% 98%;
    --border: 217.2 32.6% 17.5%;
    --input: 217.2 32.6% 17.5%;
    --ring: 212.7 26.8% 83.9%;
  }

  * { @apply border-border; -webkit-tap-highlight-color: transparent; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; touch-action: manipulation; }
  body { @apply bg-background text-foreground; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; min-height: 100vh; min-height: 100dvh; }

  button, a, input[type="submit"], input[type="button"], [role="button"] {
    min-height: var(--touch-target);
    min-width: var(--touch-target);
    touch-action: manipulation;
  }

  .glass {
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border: 1px solid rgba(255,255,255,0.15);
    box-shadow: 0 8px 32px rgba(0,0,0,0.04);
  }
  .dark .glass { background: rgba(0,0,0,0.30); border-color: rgba(255,255,255,0.06); }

  .glass-card-3d {
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 1rem;
    padding: 1rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.04), 0 0 0 1px rgba(255,255,255,0.05) inset;
    transition: all 0.4s cubic-bezier(0.34,1.56,0.64,1);
  }
  .dark .glass-card-3d { background: rgba(0,0,0,0.20); border-color: rgba(255,255,255,0.04); box-shadow: 0 4px 24px rgba(0,0,0,0.20); }
  .glass-card-3d:hover { box-shadow: 0 12px 48px rgba(83,58,253,0.08), 0 0 0 1px rgba(255,255,255,0.15) inset; transform: translateY(-4px); }

  .btn-luxury { @apply relative overflow-hidden px-6 py-3.5 rounded-xl font-medium text-white transition-all duration-300; background: linear-gradient(135deg, #9D7DC5, #533AFD); box-shadow: 0 4px 20px rgba(83,58,253,0.25); min-height: 48px; min-width: 48px; }
  .btn-luxury:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 8px 32px rgba(83,58,253,0.35); }
  .btn-luxury:active { transform: scale(0.96); }

  .btn-center-3d { @apply relative flex items-center justify-center rounded-full transition-all duration-150; width: 64px; height: 64px; background: linear-gradient(145deg, #9D7DC5, #533AFD); box-shadow: 0 6px 0 0 #3D2A5A, 0 12px 32px rgba(83,58,253,0.4); border: 2px solid rgba(255,255,255,0.20); transform: translateY(-6px); }
  .btn-center-3d:hover { transform: translateY(-12px) scale(1.04); box-shadow: 0 8px 0 0 #3D2A5A, 0 20px 40px rgba(83,58,253,0.5); }
  .btn-center-3d:active { transform: translateY(-2px) scale(0.96); box-shadow: 0 2px 0 0 #3D2A5A, 0 8px 20px rgba(83,58,253,0.25); }

  .wallet-badge { @apply flex items-center gap-1.5 px-3 py-2 rounded-full text-sm font-medium transition-all duration-300; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); color: #fff; min-height: 40px; }
  .wallet-badge:hover { background: rgba(255,255,255,0.20); transform: scale(1.02); }
  .dark .wallet-badge { background: rgba(0,0,0,0.25); border-color: rgba(255,255,255,0.06); color: #E1C5E7; }

  .scroll-reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.9s cubic-bezier(0.22,1,0.36,1), transform 0.9s cubic-bezier(0.22,1,0.36,1); }
  .scroll-reveal.in-view { opacity: 1; transform: translateY(0); }

  .safe-area-padding-bottom { padding-bottom: env(safe-area-inset-bottom, 0.5rem); }
  .safe-area-padding-top { padding-top: env(safe-area-inset-top, 0.5rem); }

  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }

  .soft-press:active { transform: scale(0.95); transition-duration: 0.08s; }

  @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
  .skeleton-shimmer { background: linear-gradient(90deg, rgba(200,200,200,0.2) 25%, rgba(200,200,200,0.4) 50%, rgba(200,200,200,0.2) 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
  .dark .skeleton-shimmer { background: linear-gradient(90deg, rgba(60,60,60,0.3) 25%, rgba(60,60,60,0.5) 50%, rgba(60,60,60,0.3) 75%); }
}

