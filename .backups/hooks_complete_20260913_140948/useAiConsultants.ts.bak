"use client";

import { useEffect, useState, useCallback } from "react";
import { getSupabaseRealtimeClient } from "@/lib/realtime/supabase-realtime";

export interface AiConsultant {
  id: string;
  name: string;
  username: string;
  avatar: string;
  category: string;
  isPaid: boolean;
  perMinuteRate: number;
  rating: number;
  totalConsultations: number;
  bio: string;
  specialties: string[];
  languages: string[];
  isActive: boolean;
  isFeatured: boolean;
  persona: string | null;
  gender: string | null;
}

interface UseAiConsultantsResult {
  consultants: AiConsultant[];
  isLoading: boolean;
  error: string | null;
  refresh: () => Promise<void>;
}

/**
 * Realtime AI consultants hook.
 *
 * Uses Supabase Realtime to auto-update when the admin panel modifies
 * any AI consultant row. No polling, no manual refresh needed.
 */
export function useAiConsultants(category?: string): UseAiConsultantsResult {
  const [consultants, setConsultants] = useState<AiConsultant[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const load = useCallback(async () => {
    try {
      setError(null);
      const url = category
        ? `/api/ai/consultants?category=${category}`
        : `/api/ai/consultants`;
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      setConsultants(Array.isArray(data) ? data : []);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to load");
    } finally {
      setIsLoading(false);
    }
  }, [category]);

  // Initial load
  useEffect(() => {
    load();
  }, [load]);

  // Realtime subscription
  useEffect(() => {
    const sb = getSupabaseRealtimeClient();
    if (!sb) return;

    const channel = sb
      .channel("ai-consultants-live")
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "AIConsultant",
        },
        (payload) => {
          const { eventType, new: newRow, old: oldRow } = payload;

          if (eventType === "INSERT") {
            setConsultants((prev) => [newRow as AiConsultant, ...prev]);
          } else if (eventType === "UPDATE") {
            setConsultants((prev) =>
              prev.map((c) =>
                c.id === (newRow as AiConsultant).id
                  ? (newRow as AiConsultant)
                  : c,
              ),
            );
          } else if (eventType === "DELETE") {
            setConsultants((prev) =>
              prev.filter((c) => c.id !== (oldRow as AiConsultant).id),
            );
          }
        },
      )
      .subscribe();

    return () => {
      sb.removeChannel(channel);
    };
  }, []);

  return { consultants, isLoading, error, refresh: load };
}
