# ─── VERCEL DEPLOYMENT ENV (paste into Vercel Dashboard) ─────────────────────
#
# Instructions:
# 1. Go to https://vercel.com/dashboard → Your Project → Settings → Environment Variables
# 2. Add each variable below for "Production", "Preview", and "Development"
# 3. Redeploy after adding

# ─── Supabase (required) ──────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Database (required for Prisma) ───────────────────────────────────────────
# Get from: Supabase → Settings → Database → Connection String (URI)
# Use the POOLED connection for serverless (port 6543)
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://zeal-web.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://zeal-admin.vercel.app
NEXT_PUBLIC_BASE_DOMAIN=vercel.app

# ─── Supabase Realtime (built-in, no extra key needed) ────────────────────────
# Just ensure Realtime is enabled in Supabase:
#   Supabase Dashboard → Database → Replication → enable for tables:
#     Notification, Wallet, Transaction, Booking, CallSession
NEXT_PUBLIC_REALTIME_ENABLED=true

# ─── Payments (Razorpay) ──────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
R2_ACCOUNT_ID=xxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxx
R2_BUCKET_NAME=zeal
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ─── AI (Groq) ────────────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxx

# ─── Optional: Redis (Upstash) ────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# ─── Video Calls (Metered – optional) ─────────────────────────────────────────
NEXT_PUBLIC_METERED_API_KEY=pk_live_xxxxxxxx
METERED_SECRET_KEY=sk_live_xxxxxxxx

# ─── Monitoring (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

// VERCEL_SETUP_APPLIED
