# Ignore build artifacts and caches
.next
.turbo
node_modules
dist
build
coverage

# Ignore env files (Vercel uses dashboard env vars)
.env
.env.local
.env.*.local
.env.production

# Ignore backups and logs
.backups
*.log
logs
tmp
temp

# Ignore IDE and OS files
.vscode
.idea
.DS_Store
Thumbs.db

# Ignore git metadata (Vercel handles this)
.git
.gitattributes

# Ignore test artifacts
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Ignore documentation (not needed at runtime)
docs
README.md
DEPLOYMENT_CHECKLIST.md
