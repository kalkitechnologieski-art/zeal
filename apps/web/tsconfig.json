{
  "extends": "../../tooling/typescript/tsconfig.base.json",
    "ignoreDeprecations": "6.0",
  "compilerOptions": {
    "typeRoots": ["./types", "./node_modules/@types"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
