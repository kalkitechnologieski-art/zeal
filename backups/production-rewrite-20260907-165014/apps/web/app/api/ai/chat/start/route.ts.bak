import { NextResponse } from "next/server";
import { auth } from "@clerk/nextjs/server";
import { prisma } from "@zeal/database";
import { withErrorHandler, AppError, HTTP_STATUS } from "@/lib/errors";
import { CallBilling } from "@/lib/calls/billing";

export const POST = withErrorHandler(async (req: Request) => {
  const { userId } = await auth();
  if (!userId) throw new AppError("Unauthorized", HTTP_STATUS.UNAUTHORIZED);
  const { aiConsultantId } = await req.json();
  if (!aiConsultantId) throw new AppError("AI consultant ID required", HTTP_STATUS.BAD_REQUEST);

  const ai = await prisma.aIConsultant.findUnique({ where: { id: aiConsultantId } });
  if (!ai) throw new AppError("AI consultant not found", HTTP_STATUS.NOT_FOUND);

  // Create a call session (AI type)
  const session = await prisma.callSession.create({
    data: {
      userId,
      consultantId: "ai-" + aiConsultantId, // dummy consultant ID for AI
      isAI: true,
      aiConsultantId: aiConsultantId,
      startTime: new Date(),
      status: "INITIATED",
    },
  });

  // Start billing (rate = ai.perMinuteRate)
  CallBilling.startBilling(session.id, ai.perMinuteRate);

  return NextResponse.json({ sessionId: session.id });
});
